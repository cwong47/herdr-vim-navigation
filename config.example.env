# herdr-vim-navigation configuration.
# Copy to config.env in the directory printed by:
#   herdr plugin config-dir herdr-vim-navigation
# Every line below is the default, so this file as it stands changes nothing.

# Command the claude-* actions run. It replaces the pane's shell (exec), so
# quitting it closes the pane. Any agent works, e.g. "codex" or "claude /my-skill".
#CLAUDE_COMMAND=claude

# Directory new agent panes start in. Empty uses the focused pane's directory.
#CLAUDE_CWD=
